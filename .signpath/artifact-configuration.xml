<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for .github/workflows/release.yml: the GitHub artifact is a zip
     with the installer and the portable exe at its root; both get an Authenticode signature.
     Paste it into the project's artifact configuration in SignPath (kept here for reference). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="game-overlai-*-setup.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="game-overlai-*-portable.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
