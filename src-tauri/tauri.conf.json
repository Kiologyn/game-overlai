{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "game-overlai",
  "version": "../web/package.json",
  "identifier": "dev.gameoverlai.app",
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "game-overlai",
    "category": "Utility",
    "shortDescription": "AI assistant overlay for any game",
    "longDescription": "A hotkey opens a question field over the game; the AI agent (Claude Code or Codex) sees the game and answers in a chat that also opens in a browser and on a phone.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDODAzQzc4MEQ0NEI1NDcKUldSSHRVUU5lRHlBZkZYOVVxbnc2d2d3WVIvbVdubmVBak1tOGFwQ3Rvd0lIQ3VDNXBXblhKS2wK",
      "endpoints": ["https://github.com/Kiologyn/game-overlai/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
